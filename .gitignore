node_modules/
uploads/
audit.db
# Secrets. The bare `.env` line alone matched ONLY a file called exactly .env,
# so every sibling — .env.local, .env.live-backup, .env.production — was
# committable. A backup of a live-key file is the same secret as the file.
# .env.example is the committed template and is negated back in.
.env
.env.*
!.env.example
*.log
.DS_Store
dist/

# Generated forensic-scan output (per-environment, never committed)
scripts/output/
data/

# Per-dataset extraction baselines: the committed fixtures use
# test/golden/extraction-baseline.json; any CV_DATASET_DIR override writes its
# own extraction-baseline.<slug>.json, which stays local (may hold real-CV hashes).
test/golden/extraction-baseline.*.json

# Editor config: ignore personal VS Code settings, but leave room to commit a
# genuinely shared .vscode/extensions.json later. Uses `.vscode/*` (not
# `.vscode/`) so the negation can re-include files — git can't re-include inside
# a wholly-excluded directory.
.vscode/*
!.vscode/extensions.json

# Video masters and the Remotion project that renders them. The encoded
# outputs that the site actually serves ARE committed, in
# public/assets/video/ — this rule is only about the sources.
#
# Do not "helpfully" commit the master: it is ~8 MB, it is a build input that
# nothing at runtime reads, and every re-render would add another full 8 MB
# blob to history (mp4 does not delta-compress). The 1080p encode in
# public/assets/video/ is derived from it and is the only copy the page needs.
# Keep masters in cloud storage, not in git.
#
# marketing/demo-video/node_modules/ is already covered by the node_modules/
# rule above, which is unanchored and so matches at any depth.
marketing/

# Demo-video pipeline OUTPUT (npm run demo:video). Everything under out/ is
# generated by the stages in demo/: an isolated SQLite database and its WAL
# sidecars, raw screen recordings, the encoded video, poster and failure
# screenshots. That is ~7.3 MB of the 7.5 MB in demo/, and none of it is an
# input to anything — the pipeline recreates it from scratch on every run.
#
# demo/ ITSELF IS SOURCE and stays tracked. package.json's demo:video,
# demo:fixtures and demo:verify run demo/run.js, demo/fixtures/generate.js and
# demo/seed/verify.js; ignoring the whole directory would break all three on a
# fresh clone with a confusing "cannot find module".
demo/out/
