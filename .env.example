# CVsprings backend environment variables
# Copy this file to .env and fill in the values for local development.
# On Render, set these via the Environment Variables panel.

# --- Server -----------------------------------------------------------------
PORT=3000                              # HTTP port the server listens on
LOG_LEVEL=info                         # pino level: trace|debug|info|warn|error|fatal

# --- CORS -------------------------------------------------------------------
# Comma-separated allowlist of browser origins. NO wildcard in production
# (a literal '*' is ignored when NODE_ENV=production). This is the only thing
# that changes when the custom domain lands. ALLOWED_ORIGINS is a legacy alias.
# Example: CORS_ALLOWED_ORIGINS=https://cvsprings.com,https://app.cvsprings.com
CORS_ALLOWED_ORIGINS=

# --- Security / uploads / rate limits ---------------------------------------
# MAX_FILE_BYTES=10485760        # per-file upload cap (default 10 MB)
# MAX_BATCH_FILES=200            # files per batch (default 200)
# MAX_TOTAL_BYTES=209715200      # aggregate request cap (default 200 MB)
# PROCESS_TIMEOUT_MS=30000       # per-file processing/scan timeout (default 30s)
# ANALYZE_RATE=60                # analyses-worth per org per 10 min (abuse guard)
# MUTATION_RATE=300              # mutating audit/template requests per org per 10 min
# SAMPLE_RATE=20                 # GET /api/analyze/sample calls per org per hour (onboarding safety net)
# TEAM_MAX_MEMBERS=0             # max users per org on the Team plan (0 = unlimited)
# ENABLE_AV_SCAN=false           # true to scan uploads before processing
# AV_SCAN_URL=                   # HTTP scanning endpoint (POST file body -> {clean:true})

# --- Database ---------------------------------------------------------------
# Absolute path to the SQLite file. On Render, this must point at a mounted
# persistent disk; otherwise data is lost on every deploy. DATABASE_PATH is
# preferred; DB_PATH remains supported as a legacy alias.
# DATABASE_PATH=/opt/render/project/data/fitscore.db

# --- Auth ---------------------------------------------------------------------
# Owner account for the "Chaulin (legacy)" organization. On boot, all pre-auth
# audit records / changes / templates are assigned to that organization and
# this user is created (if it doesn't exist) with role 'owner'.
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=                     # Min 10 chars; hashed with bcrypt on boot, never stored in plaintext

# Public customer-facing origin, used to build password-reset links
# ({PUBLIC_APP_URL}/?reset_token=...). Set this to the real domain — otherwise
# links fall back to the request host (behind Render, the *.onrender.com proxy
# host) and won't work. FRONTEND_URL and APP_BASE_URL are accepted as legacy
# aliases; the request origin is used only as a last-resort dev fallback.
# PUBLIC_APP_URL=https://cvsprings.com
# FRONTEND_URL=https://cvsprings.onrender.com

# --- Privacy ---------------------------------------------------------------------
# Shown on /privacy.html as the contact address for privacy requests.
# PRIVACY_CONTACT_EMAIL=privacy@example.com

# --- Contact / support & company details (shown on About modal + /terms.html) ----
# Served via GET /api/meta so the static pages show real values, never a
# placeholder. Set these before sharing the app with clients.
# SUPPORT_EMAIL=support@chaulin.eu
# COMPANY_LEGAL_NAME=Chaulin BV
# COMPANY_ADDRESS=Example Street 1, 1000 Brussels
# COMPANY_COUNTRY=Belgium

# --- Report branding defaults (per-org overrides set in-app fall back to these) --
# BRAND_NAME=CVsprings            # brand display name on candidate PDF reports.
#                                 # Heads the report; must stay consistent with
#                                 # the free-tier "Made with CVsprings" credit.
# BRAND_COLOR=#0f2847             # header/accent colour (hex)
# BRAND_LOGO_URL=                 # http(s) URL of the logo shown in the report header

# --- Email provider (password reset emails) -------------------------------------
# When RESEND_API_KEY is absent, reset links are logged to the server console.
# RESEND_API_KEY=                     # Resend API key (password resets, invites, demo requests)
# EMAIL_FROM=no-reply@cvsprings.com

# --- Demo requests (marketing landing page) ----------------------------------
# IP_HASH_SALT=change-me-to-a-long-random-string  # salts the sha256(ip) stored with demo requests (no raw IPs)
# DEMO_FROM_EMAIL=demo@cvsprings.com   # From: address for demo-request emails (Resend)
# DEMO_NOTIFY_EMAIL=                   # where new demo-request notifications are sent
# REPLY_TO_EMAIL=                      # Reply-To on prospect confirmations (falls back to DEMO_NOTIFY_EMAIL) — must be a monitored inbox; prospects reply with their CVs

# --- Feature requests (in-product "Suggest an improvement", Pro/Team only) ------
# The stored row is the source of truth; the email is a notification. With
# RESEND_API_KEY unset the row is still written and the send is logged, not sent.
# FEATURE_REQUEST_NOTIFY_EMAIL=jasper@cvsprings.com    # where submissions land
# FEATURE_REQUEST_FROM_EMAIL=feature-requests@cvsprings.com  # must be a Resend-verified sender.
#                                      # Deliberately NOT the shared EMAIL_FROM: this route carries
#                                      # customer-authored text, and a spam complaint against the
#                                      # shared sender would hurt password-reset deliverability.
# FEATURE_REQUEST_DAILY_MAX=5          # submissions per org per rolling 24h (enforced in SQL)
# Reply-To is always the submitting user, derived from their session — no env var.

# --- Billing / Stripe subscriptions (set before enabling /api/billing/*) -----
# Use TEST keys until the move to paid hosting (see docs/billing/README.md).
# All Stripe identifiers come from env — never hardcoded.
# STRIPE_SECRET_KEY=                  # sk_test_... (sk_live_... only after go-live)
# STRIPE_WEBHOOK_SECRET=              # whsec_... — verifies POST /api/billing/webhook
# STRIPE_PRICE_PRO=                   # price_... recurring price for the Pro plan
# STRIPE_PRICE_TEAM=                  # price_... recurring price for the Team plan
# FREE_MONTHLY_LIMIT=25               # analyses per org per calendar month on Free
# APP_BASE_URL=https://cvsprings7.onrender.com  # Checkout success/cancel + portal return base
