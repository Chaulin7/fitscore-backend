{
  "name": "fitscore-backend",
  "version": "1.3.0",
  "description": "REST API backend for CV Job Fit Analyzer (CVsprings)",
  "main": "src/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
