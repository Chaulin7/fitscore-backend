    "express": "^4.18.3",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "5.4.624",
    "pdfmake": "0.2.20",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "stripe": "^17.7.0",
    "uuid": "^9.0.1"
